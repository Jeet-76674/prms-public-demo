# ==============================================================================
# PRMS - Placement & Recruitment Management System Environment Configuration
# ==============================================================================
# Copy this file to .env or export these variables in your hosting environment
# (Docker, Render, Railway, AWS, DigitalOcean, Heroku, etc.)
# NEVER commit the actual .env file to public source control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/prms_db?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Email / SMTP Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_char_app_password

# JWT Security (Must be at least 256 bits / 32 characters hex string)
JWT_SECRET=c4a83f1e9d2b7a5061483e5c9a2d7f4b8e1c3a5f9d2e7b4c6a8f1e3d5c7a9b2d
JWT_EXPIRATION=86400000

# Demo Mode Settings
# Set to 'true' for public sandbox demo; 'false' for production university deployment
APP_DEMO_ENABLED=true
APP_DEMO_AUTO_RESET_MINUTES=0

# Allowed CORS Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting Configurations (Per client IP / user)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SIGNUP_PER_10_MINUTES=3
RATE_LIMIT_OTP_PER_HOUR=3
RATE_LIMIT_RESUME_UPLOAD_PER_HOUR=5
RATE_LIMIT_JD_UPLOAD_PER_HOUR=5
RATE_LIMIT_DEMO_RESET_PER_HOUR=5
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_UNAUTH_PER_MINUTE=60
