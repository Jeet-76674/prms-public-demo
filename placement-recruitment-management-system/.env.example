# Backend REST API Base URL (Leave empty or configure full origin if hosted separately)
# Example for local development: http://localhost:8080
# Example for cloud deployment: https://api.prms-university.edu
VITE_API_URL=http://localhost:8080

# Demo Mode Flag (Set 'true' for public sandbox demo; 'false' for production university deployment)
VITE_DEMO_MODE=true
